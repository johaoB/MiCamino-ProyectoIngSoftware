      "item": [
        {
          "name": "API-01 · GET /carreras/1 (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carreras/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carreras",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tiempo de respuesta <= 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2001));",
                  "pm.test(\"Devuelve la carrera 1\", () => pm.expect(pm.response.json().id_carrera).to.eql(1));"
                ]
              }
            }
          ]
        },
